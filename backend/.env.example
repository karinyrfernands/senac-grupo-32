# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo ".env" para o GitHub.

PORT=3000

# Dica: use uma senha SEM caracteres especiais (@ : / # ?) para evitar erros na URL abaixo.
DATABASE_URL="mysql://projeto_api:SUA_SENHA@localhost:3306/senac-grupo-32"

DB_HOST=localhost
DB_PORT=3306
DB_USER=projeto_api
DB_PASSWORD=SUA_SENHA
DB_NAME=senac-grupo-32

# Chave secreta usada para assinar os tokens de login. Gere a sua (veja o README) e NUNCA compartilhe.
# Precisa ter pelo menos 32 caracteres. O valor abaixo é só um lembrete e NÃO funciona.
JWT_SECRET=TROQUE_ESTE_VALOR

# Endereço (com porta) onde o frontend vai rodar. Precisa ser exatamente igual ao do navegador.
FRONTEND_URL=http://localhost:5173
